{
  "expo": {
    "name": "market-place-app",
    "slug": "market-place-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "marketplace",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5F7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F5F7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jhonatas.marketplaceapp",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
   "plugins": [
  "expo-router",
  [
    "expo-notifications",
    {
      "icon": "./assets/icon.png",
      "color": "#F6F5F7",
      "defaultChannelId": "default",
      "enableBackgroundRemoteNotifications": false
    }
  ],
  [
    "expo-image-picker",
    {
      "photosPermission": "Este app precisa acessar sua galeria de fotos para que você possa selecionar e enviar sua foto de perfil.",
      "cameraPermission": "Este app precisa acessar sua câmera para que você possa tirar fotos para o seu perfil."
    }
  ]
]
  }
}
